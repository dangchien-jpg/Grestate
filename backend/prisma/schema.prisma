generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model VaiTro {
  maVaiTro   Int         @id @default(autoincrement())
  tenVaiTro  String      @unique @db.VarChar(50)
  moTa       String?     @db.VarChar(255)
  createdAt  DateTime    @default(now()) @db.DateTime(0)
  updatedAt  DateTime    @updatedAt @db.DateTime(0)
  nguoiDungs NguoiDung[]

  @@map("VAITRO")
}

model NguoiDung {
  maNguoiDung     Int       @id @default(autoincrement())
  maVaiTro        Int
  hoTen           String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  matKhauHash     String    @db.VarChar(255)
  soDienThoai     String?   @db.VarChar(15)
  anhDaiDien      String?   @db.VarChar(500)
  duongDanZalo    String?   @db.VarChar(500)
  emailDaXacThuc  Boolean   @default(false)
  maXacThucEmail  String?   @db.VarChar(255)
  hanXacThucEmail DateTime? @db.DateTime(0)
  trangThai       String    @default("HOAT_DONG") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @db.DateTime(0)
  updatedAt       DateTime  @updatedAt @db.DateTime(0)
  deletedAt       DateTime? @db.DateTime(0)

  vaiTro           VaiTro            @relation(fields: [maVaiTro], references: [maVaiTro])
  phienDangNhaps   PhienDangNhap[]
  tinDangs         TinDang[]
  phanAnhTinDangs  PhanAnhTinDang[]
  lichSuKiemDuyets LichSuKiemDuyet[]
  tinDangYeuThichs TinDangYeuThich[]
  thongBaos        ThongBao[]

  @@index([maVaiTro])
  @@index([trangThai, deletedAt])
  @@map("NGUOIDUNG")
}

model PhienDangNhap {
  maPhienDangNhap Int      @id @default(autoincrement())
  maNguoiDung     Int
  refreshToken    String   @unique @db.VarChar(255)
  expiredAt       DateTime @db.DateTime(0)
  createdAt       DateTime @default(now()) @db.DateTime(0)

  nguoiDung NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)

  @@index([maNguoiDung])
  @@index([expiredAt])
  @@map("PHIENDANGNHAP")
}

model LoaiBatDongSan {
  maLoaiBatDongSan Int       @id @default(autoincrement())
  tenLoai          String    @unique @db.VarChar(100)
  moTa             String?   @db.Text
  createdAt        DateTime  @default(now()) @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @db.DateTime(0)
  tinDangs         TinDang[]

  @@map("LOAIBATDONGSAN")
}

model GiayToPhapLy {
  maGiayTo  Int       @id @default(autoincrement())
  tenGiayTo String    @unique @db.VarChar(200)
  moTa      String?   @db.Text
  createdAt DateTime  @default(now()) @db.DateTime(0)
  updatedAt DateTime  @updatedAt @db.DateTime(0)
  tinDangs  TinDang[]

  @@map("GIAYTOPHAPLY")
}

model TinhThanh {
  maTinhThanh  String     @id @db.VarChar(20)
  tenTinhThanh String     @db.VarChar(150)
  phuongXas    PhuongXa[]

  @@map("TINHTHANH")
}

model PhuongXa {
  maPhuongXa  Int    @id @default(autoincrement())
  maTinhThanh String @db.VarChar(20)
  tenPhuongXa String @db.VarChar(150)

  tinhThanh TinhThanh @relation(fields: [maTinhThanh], references: [maTinhThanh])
  tinDangs  TinDang[]

  @@index([maTinhThanh])
  @@index([maTinhThanh, tenPhuongXa])
  @@map("PHUONGXA")
}

model TinDang {
  maTinDang        Int       @id @default(autoincrement())
  maNguoiDang      Int
  maLoaiBatDongSan Int
  maGiayTo         Int?
  maPhuongXa       Int
  tieuDe           String    @db.VarChar(200)
  moTa             String    @db.Text
  diaChiChiTiet    String    @db.VarChar(255)
  viDo             Decimal?  @db.Decimal(10, 7)
  kinhDo           Decimal?  @db.Decimal(10, 7)
  giaNiemYet       Decimal   @db.Decimal(18, 2)
  dienTich         Decimal   @db.Decimal(12, 2)
  soPhongNgu       Int?
  soPhongTam       Int?
  soTang           Int?
  huongNha         String?   @db.VarChar(100)
  ngayDang         DateTime? @db.DateTime(0)
  trangThai        String    @default("CHO_KIEM_DUYET") @db.VarChar(30)
  createdAt        DateTime  @default(now()) @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @db.DateTime(0)
  deletedAt        DateTime? @db.DateTime(0)

  nguoiDang        NguoiDung         @relation(fields: [maNguoiDang], references: [maNguoiDung])
  loaiBatDongSan   LoaiBatDongSan    @relation(fields: [maLoaiBatDongSan], references: [maLoaiBatDongSan])
  giayToPhapLy     GiayToPhapLy?     @relation(fields: [maGiayTo], references: [maGiayTo])
  phuongXa         PhuongXa          @relation(fields: [maPhuongXa], references: [maPhuongXa])
  hinhAnhTinDangs  HinhAnhTinDang[]
  tinDangTienIchs  TinDangTienIch[]
  tinDangYeuThichs TinDangYeuThich[]
  phanAnhTinDangs  PhanAnhTinDang[]
  lichSuKiemDuyets LichSuKiemDuyet[]
  thongBaos        ThongBao[]

  @@index([maNguoiDang, createdAt])
  @@index([maLoaiBatDongSan])
  @@index([maGiayTo])
  @@index([maPhuongXa])
  @@index([trangThai, deletedAt, ngayDang])
  @@index([giaNiemYet])
  @@index([dienTich])
  @@map("TINDANG")
}

model TienIch {
  maTienIch       Int              @id @default(autoincrement())
  tenTienIch      String           @unique @db.VarChar(100)
  moTa            String?          @db.VarChar(255)
  createdAt       DateTime         @default(now()) @db.DateTime(0)
  updatedAt       DateTime         @updatedAt @db.DateTime(0)
  tinDangTienIchs TinDangTienIch[]

  @@map("TIENICH")
}

model TinDangTienIch {
  maTinDang Int
  maTienIch Int

  tinDang TinDang @relation(fields: [maTinDang], references: [maTinDang], onDelete: Cascade)
  tienIch TienIch @relation(fields: [maTienIch], references: [maTienIch])

  @@id([maTinDang, maTienIch])
  @@index([maTienIch])
  @@map("TINDANG_TIENICH")
}

model HinhAnhTinDang {
  maHinhAnh    Int      @id @default(autoincrement())
  maTinDang    Int
  duongDanAnh  String   @db.VarChar(500)
  thuTuHienThi Int      @default(0)
  laAnhDaiDien Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.DateTime(0)

  tinDang TinDang @relation(fields: [maTinDang], references: [maTinDang], onDelete: Cascade)

  @@index([maTinDang, thuTuHienThi])
  @@map("HINHANHTINDANG")
}

model TinDangYeuThich {
  maNguoiDung Int
  maTinDang   Int
  ngayLuu     DateTime @default(now()) @db.DateTime(0)

  nguoiDung NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)
  tinDang   TinDang   @relation(fields: [maTinDang], references: [maTinDang], onDelete: Cascade)

  @@id([maNguoiDung, maTinDang])
  @@index([maTinDang])
  @@map("TINDANGYEUTHICH")
}

model PhanAnhTinDang {
  maBaoCao      Int       @id @default(autoincrement())
  maTinDang     Int
  maNguoiBaoCao Int
  noiDung       String    @db.Text
  ngayBaoCao    DateTime  @default(now()) @db.DateTime(0)
  ngayXuLy      DateTime? @db.DateTime(0)
  hanhDongXuLy  String?   @db.VarChar(255)
  ghiChu        String?   @db.Text
  trangThai     String    @default("CHO_XU_LY") @db.VarChar(30)
  updatedAt     DateTime  @updatedAt @db.DateTime(0)

  tinDang     TinDang   @relation(fields: [maTinDang], references: [maTinDang])
  nguoiBaoCao NguoiDung @relation(fields: [maNguoiBaoCao], references: [maNguoiDung])

  @@index([maTinDang])
  @@index([maNguoiBaoCao])
  @@index([trangThai, ngayBaoCao])
  @@map("PHANANHTINDANG")
}

model LichSuKiemDuyet {
  maKiemDuyet   Int      @id @default(autoincrement())
  maTinDang     Int
  maNguoiDung   Int
  ketQua        String   @db.VarChar(50)
  ghiChu        String?  @db.Text
  ngayKiemDuyet DateTime @default(now()) @db.DateTime(0)

  tinDang   TinDang   @relation(fields: [maTinDang], references: [maTinDang])
  nguoiDung NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung])

  @@index([maTinDang, ngayKiemDuyet])
  @@index([maNguoiDung])
  @@map("LICHSUKIEMDUYET")
}

model ThongBao {
  maThongBao  Int       @id @default(autoincrement())
  maNguoiNhan Int
  maTinDang   Int?
  tieuDe      String    @db.VarChar(200)
  noiDung     String    @db.Text
  daDoc       Boolean   @default(false)
  ngayDoc     DateTime? @db.DateTime(0)
  createdAt   DateTime  @default(now()) @db.DateTime(0)

  nguoiNhan NguoiDung @relation(fields: [maNguoiNhan], references: [maNguoiDung], onDelete: Cascade)
  tinDang   TinDang?  @relation(fields: [maTinDang], references: [maTinDang], onDelete: SetNull)

  @@index([maNguoiNhan, daDoc, createdAt])
  @@index([maTinDang])
  @@map("THONGBAO")
}
