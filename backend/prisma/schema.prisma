generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model VaiTro {
  maVaiTro   Int         @id @default(autoincrement())
  tenVaiTro  String      @unique @db.VarChar(50)
  moTa       String?     @db.VarChar(255)
  createdAt  DateTime    @default(now()) @db.DateTime(0)
  updatedAt  DateTime    @updatedAt @db.DateTime(0)
  nguoiDungs NguoiDung[]

  @@map("VAITRO")
}

model NguoiDung {
  maNguoiDung     Int       @id @default(autoincrement())
  maVaiTro        Int
  hoTen           String    @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  matKhauHash     String    @db.VarChar(255)
  soDienThoai     String?   @db.VarChar(15)
  anhDaiDienUrl String? @db.VarChar(500)
  anhDaiDienId  String? @db.VarChar(255)
  duongDanZalo    String?   @db.VarChar(500)
  emailDaXacThuc  Boolean   @default(false)
  maXacThucEmail  String?   @db.VarChar(255)
  hanXacThucEmail DateTime? @db.DateTime(0)
  trangThai       String    @default("HOAT_DONG") @db.VarChar(30)
  createdAt       DateTime  @default(now()) @db.DateTime(0)
  updatedAt       DateTime  @updatedAt @db.DateTime(0)
  deletedAt       DateTime? @db.DateTime(0)

  vaiTro           VaiTro            @relation(fields: [maVaiTro], references: [maVaiTro])
  phienDangNhaps   PhienDangNhap[]
  tinDangs         TinDang[]
  phanAnhTinDangs  PhanAnhTinDang[]
  lichSuKiemDuyets LichSuKiemDuyet[]
  tinDangYeuThichs TinDangYeuThich[]
  thongBaos        ThongBao[]
  yeuCauLienHes    YeuCauLienHe[]

  yeuCauXacThucDaGuis YeuCauXacThucTinDang[] @relation("NguoiGuiXacThuc")
  yeuCauXacThucDaXuLys YeuCauXacThucTinDang[] @relation("NguoiXuLyXacThuc")

  @@index([maVaiTro])
  @@index([trangThai, deletedAt])
  @@map("NGUOIDUNG")
}

model PhienDangNhap {
  maPhienDangNhap Int      @id @default(autoincrement())
  maNguoiDung     Int
  refreshToken    String   @unique @db.VarChar(255)
  expiredAt       DateTime @db.DateTime(0)
  createdAt       DateTime @default(now()) @db.DateTime(0)

  nguoiDung NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)

  @@index([maNguoiDung])
  @@index([expiredAt])
  @@map("PHIENDANGNHAP")
}

enum NhomBatDongSan {
  NHA
  DAT
}

model LoaiBatDongSan {
  maLoaiBatDongSan Int       @id @default(autoincrement())
  tenLoai          String    @unique @db.VarChar(100)
  nhomBatDongSan   NhomBatDongSan
  moTa             String?   @db.Text
  createdAt        DateTime  @default(now()) @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @db.DateTime(0)
  deletedAt DateTime? @db.DateTime(0)
  tinDangs         TinDang[]

  @@map("LOAIBATDONGSAN")
}

model GiayToPhapLy {
  maGiayTo  Int       @id @default(autoincrement())
  tenGiayTo String    @unique @db.VarChar(200)
  moTa      String?   @db.Text
  createdAt DateTime  @default(now()) @db.DateTime(0)
  updatedAt DateTime  @updatedAt @db.DateTime(0)
  deletedAt DateTime? @db.DateTime(0)
  tinDangs  TinDang[]

  minhChungXacThucs MinhChungXacThuc[]

  @@map("GIAYTOPHAPLY")
}

model TinhThanh {
  maTinhThanh  String     @id @db.VarChar(20)
  tenTinhThanh String     @db.VarChar(150)
  phuongXas    PhuongXa[]

  @@map("TINHTHANH")
}

model PhuongXa {
  maPhuongXa  Int    @id @default(autoincrement())
  maTinhThanh String @db.VarChar(20)
  tenPhuongXa String @db.VarChar(150)

  tinhThanh TinhThanh @relation(fields: [maTinhThanh], references: [maTinhThanh])
  tinDangs  TinDang[]

  @@index([maTinhThanh])
  @@index([maTinhThanh, tenPhuongXa])
  @@map("PHUONGXA")
}

model TinDang {
  maTinDang        Int       @id @default(autoincrement())
  maNguoiDung      Int
  maLoaiBatDongSan Int
  maGiayTo         Int?
  maPhuongXa       Int
  tieuDe           String    @db.VarChar(200)
  moTa             String    @db.Text
  diaChiChiTiet    String    @db.VarChar(255)
  viDo             Decimal?  @db.Decimal(10, 7)
  kinhDo           Decimal?  @db.Decimal(10, 7)
  giaNiemYet       Decimal   @db.Decimal(18, 2)
  dienTich         Decimal   @db.Decimal(12, 2)
  soPhongNgu       Int?
  soPhongTam       Int?
  soTang           Int?
  huongNha         String?   @db.VarChar(100)
  huongBanCong     String?   @db.VarChar(100)
  noiThat          String?   @db.Text
  matTien          Decimal?  @db.Decimal(12, 2)
  matDuong         Decimal?  @db.Decimal(12, 2)
  nguoiLienHe      String?   @db.VarChar(100)
  soDienThoaiLienHe String?  @db.VarChar(15)
  videoUrl         String?   @db.VarChar(500)
  videoId          String?   @db.VarChar(255)
  ngayDang         DateTime? @db.DateTime(0)
  trangThai        String    @default("CHO_KIEM_DUYET") @db.VarChar(30)
  createdAt        DateTime  @default(now()) @db.DateTime(0)
  updatedAt        DateTime  @updatedAt @db.DateTime(0)
  deletedAt        DateTime? @db.DateTime(0)

  nguoiDang        NguoiDung         @relation(fields: [maNguoiDung], references: [maNguoiDung])
  loaiBatDongSan   LoaiBatDongSan    @relation(fields: [maLoaiBatDongSan], references: [maLoaiBatDongSan])
  giayToPhapLy     GiayToPhapLy?     @relation(fields: [maGiayTo], references: [maGiayTo])
  phuongXa         PhuongXa          @relation(fields: [maPhuongXa], references: [maPhuongXa])
  hinhAnhTinDangs  HinhAnhTinDang[]
  tinDangYeuThichs TinDangYeuThich[]
  phanAnhTinDangs  PhanAnhTinDang[]
  lichSuKiemDuyets LichSuKiemDuyet[]
  thongBaos        ThongBao[]
  yeuCauLienHes    YeuCauLienHe[]

  phienBanXacThuc Int @default(1)
  yeuCauXacThucs  YeuCauXacThucTinDang[]

  @@index([maNguoiDung, createdAt])
  @@index([maLoaiBatDongSan])
  @@index([maGiayTo])
  @@index([maPhuongXa])
  @@index([trangThai, deletedAt, ngayDang])
  @@index([giaNiemYet])
  @@index([dienTich])
  @@map("TINDANG")
}

model HinhAnhTinDang {
  maHinhAnh    Int      @id @default(autoincrement())
  maTinDang    Int
  hinhAnhUrl   String   @db.VarChar(500)
  hinhAnhId    String?  @db.VarChar(255)
  thuTuHienThi Int      @default(0)
  laAnhDaiDien Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.DateTime(0)

  tinDang TinDang @relation(fields: [maTinDang], references: [maTinDang], onDelete: Cascade)

  @@index([maTinDang, thuTuHienThi])
  @@map("HINHANHTINDANG")
}

model TinDangYeuThich {
  maNguoiDung Int
  maTinDang   Int
  ngayLuu     DateTime @default(now()) @db.DateTime(0)

  nguoiDung NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)
  tinDang   TinDang   @relation(fields: [maTinDang], references: [maTinDang], onDelete: Cascade)

  @@id([maNguoiDung, maTinDang])
  @@index([maTinDang])
  @@map("TINDANGYEUTHICH")
}

model PhanAnhTinDang {
  maBaoCao      Int       @id @default(autoincrement())
  maTinDang     Int
  maNguoiDung Int
  noiDung       String    @db.Text
  ngayBaoCao    DateTime  @default(now()) @db.DateTime(0)
  ngayXuLy      DateTime? @db.DateTime(0)
  hanhDongXuLy  String?   @db.VarChar(255)
  ghiChu        String?   @db.Text
  trangThai     String    @default("CHO_XU_LY") @db.VarChar(30)
  updatedAt     DateTime  @updatedAt @db.DateTime(0)

  tinDang     TinDang   @relation(fields: [maTinDang], references: [maTinDang])
  nguoiBaoCao NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung])

  @@index([maTinDang])
  @@index([maNguoiDung])
  @@index([trangThai, ngayBaoCao])
  @@map("PHANANHTINDANG")
}

model LichSuKiemDuyet {
  maKiemDuyet   Int      @id @default(autoincrement())
  maTinDang     Int
  maNguoiDung   Int
  ketQua        String   @db.VarChar(50)
  ghiChu        String?  @db.Text
  lyDoTuChoi    String?  @db.Text
  ngayKiemDuyet DateTime @default(now()) @db.DateTime(0)

  tinDang   TinDang   @relation(fields: [maTinDang], references: [maTinDang])
  nguoiDung NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung])

  @@index([maTinDang, ngayKiemDuyet])
  @@index([maNguoiDung])
  @@map("LICHSUKIEMDUYET")
}

model ThongBao {
  maThongBao  Int       @id @default(autoincrement())
  maNguoiDung Int
  maTinDang   Int?
  tieuDe      String    @db.VarChar(200)
  noiDung     String    @db.Text
  daDoc       Boolean   @default(false)
  ngayDoc     DateTime? @db.DateTime(0)
  createdAt   DateTime  @default(now()) @db.DateTime(0)

  nguoiNhan NguoiDung @relation(fields: [maNguoiDung], references: [maNguoiDung], onDelete: Cascade)
  tinDang   TinDang?  @relation(fields: [maTinDang], references: [maTinDang], onDelete: SetNull)

  @@index([maNguoiDung, daDoc, createdAt])
  @@index([maTinDang])
  @@map("THONGBAO")
}

enum TrangThaiYeuCauXacThuc {
  CHO_XU_LY
  DA_XAC_THUC
  TU_CHOI
}

enum NhomMinhChung {
  HO_SO_PHAP_LY
  BAT_DONG_SAN_THUC_TE
}

enum LoaiTepMinhChung {
  ANH
  VIDEO
}

model YeuCauXacThucTinDang {
  maYeuCau         Int                 @id @default(autoincrement())
  maTinDang        Int
  maNguoiYeuCau    Int
  phienBanTinLucGui Int
  trangThai        TrangThaiYeuCauXacThuc @default(CHO_XU_LY)
  ghiChuNguoiGui   String?             @db.Text
  ngayGui          DateTime            @default(now()) @db.DateTime(0)
  maNguoiXuLy      Int?
  ngayXuLy         DateTime?           @db.DateTime(0)
  lyDoXuLy         String?             @db.Text
  /// Cột do database tính: 1 khi chờ xử lý, NULL khi đã có quyết định.
  danhDauDangCho   Int?                @default(dbgenerated()) @db.TinyInt

  tinDang       TinDang          @relation(fields: [maTinDang], references: [maTinDang])
  nguoiYeuCau   NguoiDung        @relation("NguoiGuiXacThuc", fields: [maNguoiYeuCau], references: [maNguoiDung])
  nguoiXuLy     NguoiDung?       @relation("NguoiXuLyXacThuc", fields: [maNguoiXuLy], references: [maNguoiDung], onDelete: Restrict, onUpdate: Restrict)
  minhChungs    MinhChungXacThuc[]

  @@unique([maTinDang, danhDauDangCho], map: "uq_xacthuc_tin_dangcho")
  @@index([maTinDang, phienBanTinLucGui, trangThai])
  @@index([trangThai, ngayGui])
  @@index([maNguoiYeuCau])
  @@index([maNguoiXuLy])
  @@map("YEUCAUXACTHUCTINDANG")
}

model MinhChungXacThuc {
  maMinhChung    Int              @id @default(autoincrement())
  maYeuCau       Int
  nhomMinhChung  NhomMinhChung
  loaiTep        LoaiTepMinhChung
  maGiayTo       Int?
  maTepCloudinary String          @db.VarChar(255)
  dinhDangTep    String           @db.VarChar(30)
  dungLuongByte  BigInt           @db.UnsignedBigInt
  moTa           String?          @db.VarChar(255)
  thuTuHienThi   Int              @default(0)
  ngayTaiLen     DateTime         @default(now()) @db.DateTime(0)

  yeuCau YeuCauXacThucTinDang @relation(fields: [maYeuCau], references: [maYeuCau], onDelete: Cascade)
  giayTo GiayToPhapLy?        @relation(fields: [maGiayTo], references: [maGiayTo], onDelete: Restrict, onUpdate: Restrict)

  @@index([maYeuCau, thuTuHienThi])
  @@index([maGiayTo])
  @@map("MINHCHUNGXACTHUC")
}

enum TrangThaiYeuCauLienHe {
  CHO_LIEN_HE
  DA_LIEN_HE
}

model YeuCauLienHe {
  maYeuCau          Int                   @id @default(autoincrement())
  maTinDang         Int
  maNguoiGui        Int
  tenLienHe         String                @db.VarChar(100)
  soDienThoaiLienHe String                @db.VarChar(15)
  loiNhan           String?               @db.VarChar(500)
  trangThai         TrangThaiYeuCauLienHe @default(CHO_LIEN_HE)
  ngayGui           DateTime              @default(now()) @db.DateTime(0)
  ngayLienHe        DateTime?             @db.DateTime(0)
  /// MySQL đặt bằng 1 khi đang chờ và NULL khi đã liên hệ.
  danhDauDangCho    Int?                  @default(dbgenerated()) @db.TinyInt

  tinDang  TinDang   @relation(fields: [maTinDang], references: [maTinDang])
  nguoiGui NguoiDung @relation(fields: [maNguoiGui], references: [maNguoiDung])

  @@unique([maTinDang, maNguoiGui, danhDauDangCho], map: "uq_lienhe_tin_nguoi_dangcho")
  @@index([maTinDang, trangThai, ngayGui])
  @@index([maNguoiGui])
  @@map("YEUCAULIENHE")
}
